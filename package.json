  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20",
    "bun": ">=1.0.0"
  },
  "keywords": [
    "gepa",
    "prompt-optimization",
    "reflective-evolution",
    "genetic-pareto",
    "dspy",
    "llm",
    "typescript"
  ],
  "scripts": {
    "build": "tsup",
    "build:sidecar": "tsup src/sidecar/main.ts --format cjs --out-dir dist/sidecar",
    "prepublishOnly": "bun run build && bun run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pytest-shim": "bash tests/run-pytest-shim.sh",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
