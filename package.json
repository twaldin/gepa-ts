{
  "name": "@twaldin/gepa-ts",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "1-1 TypeScript port of gepa.optimize_anything (Genetic-Pareto reflective text evolution). Zero runtime deps, BYO LLM adapter, dual ESM/CJS, Node + Bun.",
  "license": "MIT",
  "author": "Tim Waldin",
  "homepage": "https://github.com/twaldin/gepa-ts",
